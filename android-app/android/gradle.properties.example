# 复制本文件为 gradle.properties 并填入你自己的签名密钥信息。
# gradle.properties 已被 .gitignore 忽略，绝不要提交到仓库（含明文密码）。
#
# macOS 生成密钥示例：
#   keytool -genkey -v -keystore ~/.android/release.keystore \
#     -alias lottery -keyalg RSA -keysize 2048 -validity 10000
#
# 注意：App 发布后务必备份密钥文件，后续升级必须用同一把签名，否则无法覆盖安装。

org.gradle.jvmargs=-Xmx1536m
android.useAndroidX=true

KEYSTORE_FILE=/Users/你的用户名/.android/release.keystore
KEYSTORE_PASSWORD=改成你的密钥库密码
KEY_PASSWORD=改成你的密钥密码
KEY_ALIAS=lottery
